POSITIVE = {
    "good", "clean", "fast", "helpful", "improved"
}

NEGATIVE = {
    "bad", "dirty", "slow", "rude", "smoke", "broken"
}

NEGATORS = {"not", "never", "no"}


def score(text):

    words = re.findall(r"\b[\w']+\b", text.lower())

    total = 0
    previous_negator = False

    for word in words:

        if word in NEGATORS:
            previous_negator = True
            continue

        value = 0

        if word in POSITIVE:
            value = 1

        elif word in NEGATIVE:
            value = -1

        if previous_negator:
            value = -value

        total += value

        previous_negator = False

    return total


def label(text):

    value = score(text)

    if value > 0:
        return "positive"

    elif value < 0:
        return "negative"

    return "neutral"


