def loop_daily_mean(filename):

    totals = defaultdict(float)
    counts = defaultdict(int)

    with open(filename, "r", encoding="utf-8") as file:

        reader = csv.DictReader(file)

        for row in reader:

            key = (row["station"], row["day"])

            totals[key] += float(row["pm25"])
            counts[key] += 1

    return {
        key: totals[key] / counts[key]
        for key in totals
    }


def pandas_daily_mean(filename):

    df = pd.read_csv(filename)

    result = df.groupby(
        ["station", "day"]
    )["pm25"].mean()

    return result.to_dict()


def sql_daily_mean(filename):

    database = sqlite3.connect(":memory:")

    database.execute("""
    CREATE TABLE readings (
        station TEXT,
        day TEXT,
        pm25 REAL
    )
    """)

    def read_records():

        with open(filename, "r", encoding="utf-8") as file:

            reader = csv.DictReader(file)

            for row in reader:

                yield (
                    row["station"],
                    row["day"],
                    float(row["pm25"])
                )

    database.executemany(
        "INSERT INTO readings VALUES (?, ?, ?)",
        read_records()
    )

    result = database.execute("""
    SELECT station, day, AVG(pm25)
    FROM readings
    GROUP BY station, day
    """).fetchall()

    database.close()

    return {
        (station, day): avg
        for station, day, avg in result
    }


# Generate yearly data
def generate_data(station_count):

    filename = f"data_{station_count}.csv"

    start_date = datetime(2026, 1, 1)

    with open(filename, "w", newline="",
              encoding="utf-8") as file:

        writer = csv.writer(file)

        writer.writerow(["station", "day", "pm25"])

        for station in range(station_count):

            name = f"Station_{station + 1}"

            for hour in range(8760):

                day = start_date + timedelta(hours=hour)

                value = 30 + (station % 50) + (hour % 100) / 10

                writer.writerow([
                    name,
                    day.strftime("%Y-%m-%d"),
                    value
                ])

    return filename


