def load_clean(text):
    rows = []

    reader = csv.DictReader(io.StringIO(text))

    required = {"station", "date", "pm25"}

    if not reader.fieldnames or not required.issubset(
        set(reader.fieldnames)
    ):
        return rows

    for row in reader:
        try:
            station = row["station"].strip()
            day = row["date"].strip()
            raw_value = row["pm25"].strip()

            if not station or not day:
                continue

            if not raw_value or raw_value.upper() == "NA":
                continue

            value = float(raw_value)

            if value < 0 or value > 999:
                continue

            datetime.strptime(day, "%Y-%m-%d")

            rows.append((station, day, value))

        except (ValueError, TypeError, KeyError):
            continue

    return rows


def min_max(values):

    if not values:
        return []

    low = min(values)
    high = max(values)

    if high == low:
        return [0.0 for value in values]

    return [
        round((value - low) / (high - low), 3)
        for value in values
    ]


