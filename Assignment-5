# SIMPLE FREQUENCY-BASED SUMMARISER
def summarise(text, k=2):

    sentences = re.split(r"(?<=[.!?])\s+", text.strip())

    words = re.findall(r"\b[a-zA-Z]+\b", text.lower())

    stop_words = {
        "the", "is", "are", "a", "an", "and",
        "was", "were", "to", "of", "in", "on",
        "but", "with", "from", "this", "that"
    }

    important = [
        word for word in words
        if word not in stop_words
    ]

    frequency = Counter(important)

    ranked = sorted(
        enumerate(sentences),
        key=lambda item: (
            sum(frequency[w] for w in
                re.findall(r"\b[a-zA-Z]+\b",
                           item[1].lower())),
            -item[0]
        ),
        reverse=True
    )

    selected = sorted(
        ranked[:k],
        key=lambda item: item[0]
    )

    return " ".join(sentence for _, sentence in selected)


# Compare first-k sentence summary
def first_k_summary(text, k=2):

    sentences = re.split(
        r"(?<=[.!?])\s+", text.strip()
    )

    return " ".join(sentences[:k])


